# Copy to .env in the same folder as compose.yaml and fill in. Never commit .env.

# Folder on the NAS that holds this app's data (three subfolders: config, postgres, caddy).
DATA_ROOT=/mnt/tank/apps/trading

# The NAS's address as you type it in a browser: its LAN IP or hostname.
NAS_HOST=192.168.1.50
HTTPS_PORT=8443

# Password for this app's own sign-in page. At least 12 characters. Not your Schwab password.
APP_PASSWORD=

# Random string, at least 32 characters. Generate with: openssl rand -hex 32
# Changing it later signs you out and makes the stored Schwab token unreadable.
SECRET_KEY=

# Database password. Generate with: openssl rand -hex 24
POSTGRES_PASSWORD=

# From the Schwab developer portal, under your app's details.
SCHWAB_APP_KEY=
SCHWAB_APP_SECRET=
# Must match the app's registered callback URL exactly.
SCHWAB_CALLBACK_URL=https://127.0.0.1:8182

# Image version to run.
IMAGE_TAG=main

# --- Phase 1 settings. All optional. ---

# Show a simulated account instead of Schwab (true/false). For previews only.
DEMO_MODE=false

# The address you open the app at, used as the link in notifications.
APP_URL=https://192.168.4.102

# Pushover notifications (pushover.net). Leave empty to turn notifications off.
PUSHOVER_USER_KEY=
PUSHOVER_APP_TOKEN=
# Weekly Schwab sign-in reminder, US Eastern time. Monday=0 ... Sunday=6.
REMINDER_WEEKDAY=6
REMINDER_HOUR=18

# Underlyings whose IV is recorded every trading day even when no position is held,
# comma-separated. Held underlyings are always recorded.
WATCHLIST=SPY
